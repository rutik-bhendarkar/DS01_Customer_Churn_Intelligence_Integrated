/* ============================================================================   RevenuePulse AI — Premium Dark Theme   Inspired by Stripe, Linear, Vercel Analytics   ============================================================================ */:root {  --color-bg: #0b1021;  --color-bg-panel: #11182a;  --color-bg-card: #16213e;  --color-bg-hover: #1e2a4a;  --color-text-primary: #f1f5f9;  --color-text-secondary: #94a3b8;  --color-text-muted: #64748b;  --accent-blue: #3b82f6;  --accent-cyan: #06b6d4;  --accent-violet: #8b5cf6;  --accent-emerald: #10b981;  --accent-amber: #f59e0b;  --accent-rose: #ef4444;  --gradient-primary: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);  --gradient-cyan: linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%);  --gradient-emerald: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);  --gradient-rose: linear-gradient(135deg, #ef4444 0%, #f97316 100%);/* ===== KPI CARDS ===== */}  /* ===== SIDEBAR & COMPONENT STYLES ===== */}.kpi-grid {  display: grid;  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));  gap: 1rem;  margin-bottom: 1.5rem;}.kpi-card {  position: relative;  background: var(--gradient-card);  border: 1px solid #1f2a4a;  border-radius: var(--radius-lg);  padding: 1.25rem 1.25rem 1rem;  box-shadow: var(--shadow-md);  transition: transform var(--transition-base), box-shadow var(--transition-base), border-color var(--transition-base);}.kpi-card:hover {  transform: translateY(-2px);  box-shadow: var(--shadow-lg), var(--shadow-glow);  border-color: rgba(99, 102, 241, 0.35);}.kpi-card .kpi-label {  font-size: 0.75rem; font-weight: 600; text-transform: uppercase;  letter-spacing: 0.05em; color: var(--color-text-muted);  margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;}.kpi-card .kpi-value {  font-size: 2rem; font-weight: 700; color: var(--color-text-primary);  line-height: 1.1; margin-bottom: 0.25rem;}.kpi-card .kpi-subtitle { font-size: 0.875rem; color: var(--color-text-secondary); }.kpi-card .kpi-icon {  position: absolute; top: 1.1rem; right: 1.1rem; width: 2rem; height: 2rem;  border-radius: var(--radius-md); display: grid; place-items: center;  background: rgba(255, 255, 255, 0.06); color: var(--color-text-secondary); font-size: 1rem;}.kpi-card.accent-blue .kpi-icon   { color: var(--accent-blue); background: rgba(59, 130, 246, 0.12); }.kpi-card.accent-cyan .kpi-icon   { color: var(--accent-cyan); background: rgba(6, 182, 212, 0.12); }.kpi-card.accent-violet .kpi-icon { color: var(--accent-violet); background: rgba(139, 92, 246, 0.12); }.kpi-card.accent-emerald .kpi-icon { color: var(--accent-emerald); background: rgba(16, 185, 129, 0.12); }.kpi-card.accent-amber .kpi-icon   { color: var(--accent-amber); background: rgba(245, 158, 11, 0.12); }.kpi-card.accent-rose .kpi-icon    { color: var(--accent-rose); background: rgba(239, 68, 68, 0.12); }@keyframes countUp {  from { opacity: 0; transform: translateY(4px); }  to { opacity: 1; transform: translateY(0); }}.kpi-card .kpi-value { animation: countUp var(--transition-base) both; }  --gradient-card: linear-gradient(145deg, #1c294a 0%, #16213e 100%);  --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.4);  --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.5), 0 2px 4px -2px rgb(0 0 0 / 0.3);  --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.6), 0 4px 6px -4px rgb(0 0 0 / 0.4);  --shadow-glow: 0 0 20px rgb(59 130 246 / 0.15);  --radius-sm: 6px;  --radius-md: 10px;  --radius-lg: 16px;  --radius-xl: 24px;  --transition-fast: 150ms cubic-bezier(0.4, 0, 0.2, 1);  --transition-base: 250ms cubic-bezier(0.4, 0, 0.2, 1);}.stApp { background: var(--color-bg); color: var(--color-text-primary); }#MainMenu, footer, header, .stDeployButton, .stActionButton { visibility: hidden; }.block-container {  padding-top: 1.5rem; padding-bottom: 3rem; max-width: 100%; background: transparent;}h1, h2, h3, h4, h5, h6 { color: var(--color-text-primary); font-weight: 700; letter-spacing: -0.02em; }h1 { font-size: 1.875rem; margin-bottom: 0.25rem;  background: var(--gradient-primary);  -webkit-background-clip: text; -webkit-text-fill-color: transparent; }h2 { font-size: 1.5rem; margin-top: 1.5rem; margin-bottom: 1rem; color: var(--color-text-primary); }h3 { font-size: 1.25rem; color: var(--color-text-secondary); }.section-header {  display: flex; align-items: center; gap: 0.75rem;  margin-bottom: 1.25rem; padding-bottom: 0.75rem; border-bottom: 1px solid #1f2a4a;/* ===== CARDS & PANELS ===== */.premium-card {  background: var(--gradient-card);  border: 1px solid #1f2a4a;  border-radius: var(--radius-lg);  padding: 1.5rem; margin-bottom: 1.25rem; box-shadow: var(--shadow-md);}.premium-card-header {  display: flex; align-items: center; gap: 0.75rem;  margin-bottom: 1rem; padding-bottom: 0.75rem; border-bottom: 1px solid #1f2a4a;}.premium-card-header h3 { margin: 0; font-size: 1.125rem; color: var(--color-text-primary); }/* ===== RISK BADGES ===== */.risk-badge {  display: inline-flex; align-items: center; gap: 0.5rem;  padding: 0.35rem 0.875rem; border-radius: 999px;  font-size: 0.75rem; font-weight: 700; text-transform: uppercase;  letter-spacing: 0.05em; box-shadow: var(--shadow-sm);}.risk-badge.low   { background: rgba(16, 185, 129, 0.12); color: var(--accent-emerald); border: 1px solid rgba(16, 185, 129, 0.25); }.risk-badge.medium { background: rgba(245, 158, 11, 0.12); color: var(--accent-amber); border: 1px solid rgba(245, 158, 11, 0.25); }.risk-badge.high  { background: rgba(239, 68, 68, 0.12); color: var(--accent-rose); border: 1px solid rgba(239, 68, 68, 0.25); }.risk-badge .badge-dot { width: 6px; height: 6px; border-radius: 50%; }.risk-badge.low .badge-dot   { background: var(--accent-emerald); box-shadow: 0 0 6px var(--accent-emerald); }.risk-badge.medium .badge-dot { background: var(--accent-amber); box-shadow: 0 0 6px var(--accent-amber); }.risk-badge.high .badge-dot  { background: var(--accent-rose); box-shadow: 0 0 6px var(--accent-rose); }/* ===== SIDEBAR OVERRIDES ===== */[data-testid="stSidebar"] {  background: linear-gradient(180deg, #0f172a 0%, #0b1021 100%);  border-right: 1px solid #1f2a4a;}[data-testid="stSidebar"] .stSidebarContent {  color: var(--color-text-secondary); padding-top: 1.5rem;}[data-testid="stSidebar"] .stButton > button {  width: 100%; background: transparent; border: none; text-align: left;  padding: 0.75rem 1rem; border-radius: var(--radius-md);  color: var(--color-text-secondary); font-weight: 500;  transition: all var(--transition-fast); margin-bottom: 0.25rem; border: 1px solid transparent;}[data-testid="stSidebar"] .stButton > button:hover {  background: rgba(255, 255, 255, 0.04); color: var(--color-text-primary);  border-color: rgba(255, 255, 255, 0.08);}[data-testid="stSidebar"] .stButton > button.active-nav {  background: rgba(59, 130, 246, 0.12); color: var(--accent-blue);  border-color: rgba(59, 130, 246, 0.3);  box-shadow: inset 0 0 0 1px rgba(59, 130, 246, 0.2);}.sidebar-brand {  display: flex; align-items: center; gap: 0.75rem;  padding: 1rem 1.5rem; margin-bottom: 1.5rem; border-bottom: 1px solid #1f2a4a;}.sidebar-brand .brand-icon {  width: 2.25rem; height: 2.25rem; border-radius: var(--radius-md);  background: var(--gradient-primary); display: grid; place-items: center; box-shadow: var(--shadow-md);}.sidebar-brand .brand-text { font-weight: 800; font-size: 1.125rem; color: var(--color-text-primary); letter-spacing: -0.02em; }.sidebar-brand .brand-tag { font-size: 0.6875rem; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 0.125rem; }.source-indicator {  margin-top: 1rem; padding: 0.75rem;  background: rgba(16, 185, 129, 0.08); border: 1px solid rgba(16, 185, 129, 0.2);  border-radius: var(--radius-md); font-size: 0.75rem; color: var(--accent-emerald);  display: flex; align-items: center; gap: 0.5rem;}}.section-header h2 { margin: 0; font-size: 1.25rem; }.section-header .section-icon { font-size: 1.25rem; }/* ===== FORMS & INPUTS ===== */.stSelectbox > div > div,.stTextInput > div > div > input,.stNumberInput > div > div > input,.stSlider > div {  background: var(--color-bg-card) !important;  border: 1px solid #1f2a4a !important;  color: var(--color-text-primary) !important;  border-radius: var(--radius-md) !important;}.stSelectbox > div > div:focus-within,.stTextInput > div > div > input:focus,.stNumberInput > div > div > input:focus {  border-color: var(--accent-blue) !important;  box-shadow: 0 0 0 1px var(--accent-blue) !important;}.stDownloadButton > button {  background: var(--gradient-primary) !important; border: none !important;  color: white !important; border-radius: var(--radius-md) !important;  font-weight: 600 !important; transition: transform var(--transition-fast), opacity var(--transition-fast);}.stDownloadButton > button:hover { transform: translateY(-1px); opacity: 0.92; }.stButton > button {  background: var(--color-bg-card) !important; border: 1px solid #1f2a4a !important;  color: var(--color-text-primary) !important; border-radius: var(--radius-md) !important;  font-weight: 600 !important; transition: all var(--transition-fast);}.stButton > button:hover { border-color: var(--accent-blue); color: var(--accent-blue); }[data-testid="stDataFrame"] {  border: 1px solid #1f2a4a !important; border-radius: var(--radius-lg) !important;  overflow: hidden; box-shadow: var(--shadow-md);}.streamlit-expanderHeader {  background: var(--color-bg-card); border: 1px solid #1f2a4a !important;  border-radius: var(--radius-md) !important; color: var(--color-text-secondary); font-weight: 600;}.stTabs [data-baseweb="tab-list"] {  gap: 0.5rem; background: transparent; padding-bottom: 0.5rem; border-bottom: 1px solid #1f2a4a;}.stTabs [data-baseweb="tab"] {  background: transparent !important; color: var(--color-text-muted) !important;  border-radius: var(--radius-md) !important; padding: 0.5rem 1rem !important;  font-weight: 600; transition: all var(--transition-fast);}.stTabs [aria-selected="true"] {  background: rgba(59, 130, 246, 0.1) !important; color: var(--accent-blue) !important;  border-color: rgba(59, 130, 246, 0.25) !important;}.js-plotly-plot {  border: 1px solid #1f2a4a !important; border-radius: var(--radius-lg) !important;  background: var(--color-bg-card) !important; box-shadow: var(--shadow-md);}@media (prefers-reduced-motion: reduce) {  .kpi-card, .kpi-card:hover, .stButton > button, .stDownloadButton > button { transition: none; }  .kpi-card .kpi-value { animation: none; }}@media (max-width: 768px) {  .kpi-grid { grid-template-columns: 1fr; }  .kpi-card .kpi-value { font-size: 1.5rem; }  h1 { font-size: 1.5rem; }}.text-muted { color: var(--color-text-muted); font-size: 0.875rem; }.flex-between { display: flex; justify-content: space-between; align-items: center; }.mt-2 { margin-top: 0.5rem; }.mb-2 { margin-bottom: 0.5rem; }/* ===== REVENUEPULSE SIDEBAR =====   Component-specific styles intentionally stay scoped to the sidebar. */[data-testid="stSidebar"] {  background: linear-gradient(180deg, #0b1225 0%, #101a35 52%, #0b1021 100%);}[data-testid="stSidebar"] [data-testid="stSidebarContent"] {  padding: 0.7rem 0.8rem 1rem;}.rp-brand { display:flex; align-items:center; gap:.65rem; padding:.45rem .15rem 1rem; border-bottom:1px solid rgba(148,163,184,.18); }.rp-brand__mark { display:grid; place-items:center; flex:0 0 2.5rem; width:2.5rem; height:2.5rem; color:#dbeafe; border-radius:.78rem; background:linear-gradient(135deg,#3b82f6,#7657e8); box-shadow:0 8px 20px rgba(59,130,246,.25); }.rp-brand__mark svg { width:1.35rem; height:1.35rem; }.rp-brand__copy { min-width:0; flex:1; }.rp-brand__title { color:#f8fafc; font-size:1rem; font-weight:750; letter-spacing:-.025em; white-space:nowrap; }.rp-brand__subtitle { overflow:hidden; color:#94a3b8; font-size:.625rem; line-height:1.35; text-overflow:ellipsis; text-transform:uppercase; letter-spacing:.065em; white-space:nowrap; }.rp-environment { padding:.22rem .42rem; border-radius:999px; background:rgba(16,185,129,.14); color:#55e6b3; font-size:.59rem; font-weight:800; letter-spacing:.05em; }/* Streamlit's own navigation is retained, with a premium presentation. */[data-testid="stSidebar"] [data-testid="stSidebarNav"] { margin: .8rem -.15rem .45rem; }[data-testid="stSidebar"] [data-testid="stSidebarNav"] [data-testid="stSidebarNavHeader"] { color:#8da2c7; font-size:.66rem; font-weight:750; letter-spacing:.07em; text-transform:uppercase; }[data-testid="stSidebar"] [data-testid="stSidebarNav"] a { position:relative; min-height:2.55rem; margin:.12rem 0; border:1px solid transparent; border-radius:.65rem; color:#c7d2e8; font-weight:550; transition:background 160ms ease, border-color 160ms ease, color 160ms ease, transform 160ms ease; }[data-testid="stSidebar"] [data-testid="stSidebarNav"] a:hover { transform:translateX(2px); background:rgba(148,163,184,.08); border-color:rgba(148,163,184,.13); color:#f8fafc; }[data-testid="stSidebar"] [data-testid="stSidebarNav"] a[aria-current="page"] { background:linear-gradient(100deg,rgba(59,130,246,.30),rgba(124,92,246,.18)); border-color:rgba(96,165,250,.28); color:#fff; box-shadow:inset 3px 0 0 #60a5fa, 0 5px 12px rgba(15,23,42,.18); }[data-testid="stSidebar"] [data-testid="stSidebarNav"] a[aria-current="page"] svg { color:#9bc4ff; }.rp-sidebar-card { margin:.68rem 0; padding:.76rem; border:1px solid rgba(100,116,139,.23); border-radius:.8rem; background:linear-gradient(145deg,rgba(25,40,76,.75),rgba(15,24,48,.78)); box-shadow:0 8px 20px rgba(0,0,0,.13); }.rp-card-heading { display:flex; align-items:center; justify-content:space-between; gap:.4rem; color:#e2e8f0; font-size:.72rem; font-weight:750; letter-spacing:.025em; }.rp-status { display:inline-flex; align-items:center; gap:.28rem; padding:.17rem .35rem; border-radius:99px; font-size:.57rem; font-weight:750; white-space:nowrap; }.rp-status i { width:.32rem; height:.32rem; border-radius:50%; background:currentColor; box-shadow:0 0 7px currentColor; }.rp-status--valid { color:#52dfa9; background:rgba(16,185,129,.11); }.rp-status--warning { color:#f7bf61; background:rgba(245,158,11,.11); }.rp-status--invalid { color:#fb8b99; background:rgba(239,68,68,.11); }.rp-health-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.52rem; margin:.7rem 0; }.rp-health-grid div { padding:.42rem; border-radius:.48rem; background:rgba(15,23,42,.46); }.rp-health-grid b,.rp-health-grid span { display:block; }.rp-health-grid b { color:#eaf1ff; font-size:.78rem; }.rp-health-grid span,.rp-source span { color:#8497b9; font-size:.59rem; }.rp-quality > div:first-child { display:flex; justify-content:space-between; color:#91a4c6; font-size:.62rem; }.rp-quality b { color:#cbd8f0; }.rp-quality__track { height:.27rem; margin:.3rem 0 .65rem; overflow:hidden; border-radius:999px; background:#1e2d4d; }.rp-quality__track i { display:block; height:100%; border-radius:inherit; background:linear-gradient(90deg,#38bdf8,#8b5cf6); }.rp-source { padding-top:.55rem; border-top:1px solid rgba(148,163,184,.13); }.rp-source b,.rp-source small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.rp-source b { margin-top:.14rem; color:#d6e2f5; font-size:.67rem; }.rp-source small { color:#8092b4; font-size:.59rem; }.rp-upload-card { margin-bottom:.35rem; }.rp-upload-card p { margin:.32rem 0 0; color:#91a4c6; font-size:.66rem; line-height:1.35; }.rp-format { padding:.14rem .32rem; border:1px solid rgba(96,165,250,.3); border-radius:.25rem; color:#8ec5ff; font-size:.56rem; }[data-testid="stSidebar"] [data-testid="stFileUploader"] { margin-top:.15rem; padding:.2rem; border:1px dashed rgba(100,116,139,.45); border-radius:.66rem; background:rgba(15,23,42,.32); } [data-testid="stSidebar"] [data-testid="stFileUploader"] button { font-size:.68rem; }.rp-project-profile { display:flex; align-items:center; gap:.55rem; margin-top:.82rem; padding:.68rem .25rem .1rem; border-top:1px solid rgba(148,163,184,.18); }.rp-project-profile__avatar { display:grid; place-items:center; width:1.9rem; height:1.9rem; border-radius:50%; background:linear-gradient(135deg,#38bdf8,#7c3aed); color:white; font-size:.62rem; font-weight:800; }.rp-project-profile b,.rp-project-profile small { display:block; }.rp-project-profile b { color:#dce7f8; font-size:.68rem; }.rp-project-profile small { color:#7f91b1; font-size:.58rem; line-height:1.35; }@media (prefers-reduced-motion: reduce) { [data-testid="stSidebar"] [data-testid="stSidebarNav"] a { transition:none; } }